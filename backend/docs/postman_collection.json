{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Multi-Vendor Marketplace - Week 1 & 2 Complete API Suite",
    "description": "Comprehensive Postman Collection covering Week 1 (Auth, JWT, RBAC) and Week 2 (Vendor Dashboard, Product Management CRUD, and Multipart Uploads).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "vendorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdProductId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Register - Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('customerToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"alice.customer@axlero.com\",\n  \"password\": \"CustomerSecure123!\",\n  \"role\": \"customer\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Register - Vendor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('vendorToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Vendor\",\n  \"email\": \"bob.vendor@axlero.com\",\n  \"password\": \"VendorSecure123!\",\n  \"role\": \"vendor\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login - Vendor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('vendorToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob.vendor@axlero.com\",\n  \"password\": \"VendorSecure123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Get Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "RBAC Vendor Check (200 OK for Vendor)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/vendor/dashboard"
          }
        },
        {
          "name": "RBAC Vendor Check (403 Forbidden for Customer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/vendor/dashboard"
          }
        }
      ]
    },
    {
      "name": "2. Product Management (Multi-Vendor CRUD)",
      "item": [
        {
          "name": "Create Product - Vendor (Multipart Form)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('createdProductId', res.data.id);",
                  "    console.log('Saved product ID:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Ergonomic Mechanical Keyboard", "type": "text" },
                { "key": "description", "value": "High precision RGB keyboard.", "type": "text" },
                { "key": "price", "value": "89.99", "type": "text" },
                { "key": "stock", "value": "25", "type": "text" },
                { "key": "category", "value": "Electronics", "type": "text" },
                { "key": "status", "value": "active", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Get Authenticated Vendor's Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }],
            "url": "{{baseUrl}}/api/v1/products/vendor"
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{createdProductId}}"
          }
        },
        {
          "name": "Update Product Listing (Vendor Owned)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "price", "value": "79.99", "type": "text" },
                { "key": "stock", "value": "30", "type": "text" },
                { "key": "status", "value": "active", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/products/{{createdProductId}}"
          }
        },
        {
          "name": "Delete Product Listing (Vendor Owned)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }],
            "url": "{{baseUrl}}/api/v1/products/{{createdProductId}}"
          }
        }
      ]
    }
  ]
}
