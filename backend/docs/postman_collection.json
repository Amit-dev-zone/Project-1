{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Multi-Vendor Marketplace - Week 1 Auth & RBAC",
    "description": "Postman Collection for Week 1 Deliverables: Authentication & Role-Based Access Control (Admin, Vendor, Customer) for Axlero Multi-Vendor Marketplace Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "vendorToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "2. Register - Customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data && res.data.token) {",
              "    pm.collectionVariables.set('customerToken', res.data.token);",
              "    console.log('Customer token saved to collection variable');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"alice.customer@axlero.com\",\n  \"password\": \"CustomerSecure123!\",\n  \"role\": \"customer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "3. Register - Vendor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data && res.data.token) {",
              "    pm.collectionVariables.set('vendorToken', res.data.token);",
              "    console.log('Vendor token saved to collection variable');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob Vendor\",\n  \"email\": \"bob.vendor@axlero.com\",\n  \"password\": \"VendorSecure123!\",\n  \"role\": \"vendor\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "4. Login - Vendor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data && res.data.token) {",
              "    pm.collectionVariables.set('vendorToken', res.data.token);",
              "    console.log('Vendor token updated from login');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob.vendor@axlero.com\",\n  \"password\": \"VendorSecure123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "5. Get Profile (/me) - Authorized",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vendorToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      },
      "response": []
    },
    {
      "name": "6. Vendor Dashboard - Allowed for Vendor",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vendorToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/vendor/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "vendor", "dashboard"]
        }
      },
      "response": []
    },
    {
      "name": "7. Vendor Dashboard - Forbidden (403) for Customer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/vendor/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "vendor", "dashboard"]
        }
      },
      "response": []
    },
    {
      "name": "8. Admin Dashboard - Forbidden (403) for Vendor",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vendorToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/admin/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "admin", "dashboard"]
        }
      },
      "response": []
    }
  ]
}
